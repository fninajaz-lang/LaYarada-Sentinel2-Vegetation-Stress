var years = ee.List.sequence(2017, 2025);

var annualTable = ee.FeatureCollection(
  years.map(function(y) {
    y = ee.Number(y);
    var fy = table.filter(ee.Filter.eq('year', y));

    return ee.Feature(null, {
      year: y,
      NDVI: fy.aggregate_mean('NDVI'),
      NDMI: fy.aggregate_mean('NDMI'),
      n_blocks: fy.size()
    });
  })
).sort('year');

print('Tabla anual:', annualTable);

var chartAnnual = ui.Chart.feature.byFeature(annualTable, 'year', ['NDVI', 'NDMI'])
  .setChartType('LineChart')
  .setOptions({
    title: 'Promedio anual NDVI y NDMI - La Yarada Los Palos',
    hAxis: {title: 'Año'},
    vAxis: {title: 'Indice'},
    lineWidth: 2,
    pointSize: 5
  });

print(chartAnnual);


// ESTRES HIDRICO

var stress = ndmi.expression(
  "(ndmi < 0.10) ? 1" +
  ": (ndmi < 0.25) ? 2" +
  ": 3",
  {ndmi: ndmi}
).rename('stress').clip(roi);

Map.addLayer(
  stress,
  {min: 1, max: 3, palette: ['red', 'yellow', 'green']},
  'Stress map'
);


var areaImage = ee.Image.pixelArea().addBands(stress);

var areas = areaImage.reduceRegion({
  reducer: ee.Reducer.sum().group({
    groupField: 1,
    groupName: 'class'
  }),
  geometry: roi,
  scale: 20,
  tileScale: 4,
  maxPixels: 1e13,
  bestEffort: true
});

print('Areas por clase (m2):', areas);

var areasList = ee.List(areas.get('groups'));

var areaTable = ee.FeatureCollection(
  areasList.map(function(item) {
    item = ee.Dictionary(item);
    return ee.Feature(null, {
      class: item.get('class'),
      area_m2: item.get('sum'),
      area_km2: ee.Number(item.get('sum')).divide(1e6)
    });
  })
).sort('class');

print('Tabla de areas por estres:', areaTable);


