// ANALISIS NDVI + NDMI + CORRELACION + ESTRES HIDRICO


var roi = yarada;
Map.centerObject(roi, 11);
Map.addLayer(roi, {color: 'red'}, 'ROI - La Yarada Los Palos');
Map.setOptions('SATELLITE');

// MASCARA DE NUBES

function maskS2sr(img) {
  var scl = img.select('SCL');
  var mask = scl.neq(3)
    .and(scl.neq(8))
    .and(scl.neq(9))
    .and(scl.neq(10))
    .and(scl.neq(11));
  return img.updateMask(mask);
}


// FUNCION AUXILIAR: ESTADISTICAS NDVI/NDMI

function periodStats(col) {
  var comp = ee.Image(col.median());

  var ndviImg = comp.normalizedDifference(['B8', 'B4']).rename('NDVI');
  var ndmiImg = comp.normalizedDifference(['B8', 'B11']).rename('NDMI');

  return ee.Dictionary(
    ndviImg.addBands(ndmiImg).reduceRegion({
      reducer: ee.Reducer.mean(),
      geometry: roi,
      scale: 60,          // más liviano para la serie temporal
      bestEffort: true,
      tileScale: 4,
      maxPixels: 1e13
    })
  );
}



var s2raw = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
  .filterBounds(roi)
  .filterDate('2017-01-01', '2025-12-31')
  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 30))
  .select(['B2', 'B3', 'B4', 'B8', 'B11', 'SCL']);

var s2 = s2raw.map(maskS2sr);

print('Numero de imagenes:', s2.size());
print('Bandas de la primera imagen:', ee.Image(s2.first()).bandNames());


var rgb_raw = s2raw.select(['B4', 'B3', 'B2']).median().clip(roi);
var rgb = s2.select(['B4', 'B3', 'B2']).median().clip(roi);
var swir = s2.select(['B11', 'B8', 'B4']).median().clip(roi);

var ndvi = s2.select(['B8', 'B4'])
  .median()
  .normalizedDifference(['B8', 'B4'])
  .rename('NDVI')
  .clip(roi);

var ndmi = s2.select(['B8', 'B11'])
  .median()
  .normalizedDifference(['B8', 'B11'])
  .rename('NDMI')
  .clip(roi);

var stressIndex = ndvi.subtract(ndmi).rename('StressIndex').clip(roi);

// Visualización en mapa
Map.addLayer(rgb_raw, {bands: ['B4', 'B3', 'B2'], min: 0, max: 3000}, 'RGB sin filtro');
Map.addLayer(rgb, {bands: ['B4', 'B3', 'B2'], min: 0, max: 3000}, 'RGB filtrado');
Map.addLayer(swir, {bands: ['B11', 'B8', 'B4'], min: 0, max: 3500}, 'Falso color SWIR');
Map.addLayer(ndvi, {min: -0.2, max: 0.8, palette: ['brown', 'yellow', 'green']}, 'NDVI');
Map.addLayer(ndmi, {min: -0.5, max: 0.5, palette: ['red', 'yellow', 'green']}, 'NDMI');
Map.addLayer(stressIndex, {min: -0.2, max: 0.4, palette: ['blue', 'white', 'red']}, 'NDVI - NDMI');


// TABLA 
var start = ee.Date('2017-01-01');
var periods = ee.List.sequence(0, 26);  // 27 bloques de 4 meses

var tableList = ee.List(
  periods.iterate(function(p, acc) {
    p = ee.Number(p);
    acc = ee.List(acc);

    var startDate = start.advance(p.multiply(4), 'month');
    var endDate = startDate.advance(4, 'month');

    var block = s2.filterDate(startDate, endDate);

    var item = ee.Algorithms.If(
      block.size().gt(0),
      (function() {
        var stats = periodStats(block);
        return acc.add(ee.Feature(null, {
          time: startDate.millis(),
          date: startDate.format('YYYY-MM'),
          year: startDate.get('year'),
          month: startDate.get('month'),
          NDVI: stats.get('NDVI'),
          NDMI: stats.get('NDMI')
        }));
      })(),
      acc
    );

    return item;
  }, ee.List([]))
);

var table = ee.FeatureCollection(tableList)
  .filter(ee.Filter.notNull(['NDVI', 'NDMI']))
  .sort('time');

print('Tabla temporal:', table);

